import "dotenv/config";

export function getGitHubToken(): string {
  const token = process.env.GITHUB_TOKEN;

  if (!token) {
    throw new Error(
      "GITHUB_TOKEN is missing. Create a .env file or export GITHUB_TOKEN."
    );
  }

  return token;
}


