import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { mkdir, writeFile, access } from "node:fs/promises";
import path from "node:path";

const exec = promisify(execFile);

export async function commandExists(command: string): Promise<boolean> {
  try {
    await exec(
      process.platform === "win32" ? "where" : "which",
      [command]
    );

    return true;
  } catch {
    return false;
  }
}

export async function initializeLocalRepository(
  directory: string,
  repositoryUrl: string,
  readmeContent: string
): Promise<void> {
  const absolutePath = path.resolve(directory);

  await mkdir(absolutePath, { recursive: true });

  const gitAvailable = await commandExists("git");

  if (!gitAvailable) {
    throw new Error(
      "Git is not installed or is not available in PATH."
    );
  }

  try {
    await access(path.join(absolutePath, ".git"));
  } catch {
    await exec("git", ["init"], {
      cwd: absolutePath
    });
  }

  await writeFile(
    path.join(absolutePath, "README.md"),
    readmeContent,
    "utf8"
  );

  await exec("git", ["add", "."], {
    cwd: absolutePath
  });

  await exec(
    "git",
    [
      "-c",
      "user.name=Repolet",
      "-c",
      "user.email=repolet@localhost",
      "commit",
      "-m",
      "chore: initialize repository"
    ],
    {
      cwd: absolutePath
    }
  );

  await exec(
    "git",
    ["branch", "-M", "main"],
    {
      cwd: absolutePath
    }
  );

  await exec(
    "git",
    ["remote", "add", "origin", repositoryUrl],
    {
      cwd: absolutePath
    }
  );

  await exec(
    "git",
    ["push", "-u", "origin", "main"],
    {
      cwd: absolutePath
    }
  );
}


