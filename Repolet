import { Octokit } from "@octokit/rest";
import { getGitHubToken } from "./config.js";
import type { RepositoryOptions, GitHubRepository } from "./types.js";

export class GitHubClient {
  private readonly octokit: Octokit;

  constructor() {
    this.octokit = new Octokit({
      auth: getGitHubToken()
    });
  }

  async getAuthenticatedUser(): Promise<string> {
    const { data } = await this.octokit.users.getAuthenticated();
    return data.login;
  }

  async createRepository(
    options: RepositoryOptions
  ): Promise<GitHubRepository> {
    const owner = await this.getAuthenticatedUser();

    const { data } = await this.octokit.repos.createForAuthenticatedUser({
      name: options.name,
      description: options.description,
      private: options.private,
      auto_init: options.initialize,
      gitignore_template: options.gitignore,
      license_template: options.license
    });

    return {
      id: data.id,
      name: data.name,
      full_name: data.full_name,
      html_url: data.html_url,
      clone_url: data.clone_url,
      ssh_url: data.ssh_url,
      private: data.private
    };
  }

  async repositoryExists(
    owner: string,
    repository: string
  ): Promise<boolean> {
    try {
      await this.octokit.repos.get({
        owner,
        repo: repository
      });

      return true;
    } catch (error: any) {
      if (error.status === 404) {
        return false;
      }

      throw error;
    }
  }
}


