#!/usr/bin/env node

import { Command } from "commander";
import chalk from "chalk";
import ora from "ora";

import { GitHubClient } from "./github.js";
import { createReadme } from "./templates.js";
import {
  initializeLocalRepository
} from "./repository.js";

import type {
  RepositoryOptions,
  RepositoryVisibility
} from "./types.js";

const program = new Command();

program
  .name("repolet")
  .description(
    "Professional GitHub repository creation and initialization CLI."
  )
  .version("1.0.0");

program
  .command("create")
  .description("Create and initialize a GitHub repository")
  .argument("<name>", "Repository name")
  .option(
    "-d, --description <description>",
    "Repository description"
  )
  .option(
    "--private",
    "Create a private repository",
    false
  )
  .option(
    "--public",
    "Create a public repository",
    false
  )
  .option(
    "--no-init",
    "Do not initialize the local repository"
  )
  .option(
    "--directory <directory>",
    "Local project directory"
  )
  .action(async (name: string, options) => {
    const spinner = ora("Creating GitHub repository...").start();

    try {
      const visibility: RepositoryVisibility =
        options.private ? "private" : "public";

      const repositoryOptions: RepositoryOptions = {
        name,
        description: options.description,
        visibility,
        private: visibility === "private",
        initialize: true,
        directory: options.directory ?? name
      };

      const github = new GitHubClient();

      const repository = await github.createRepository(
        repositoryOptions
      );

      spinner.succeed("GitHub repository created.");

      console.log();
      console.log(
        chalk.green("Repository:"),
        repository.full_name
      );

      console.log(
        chalk.blue("URL:"),
        repository.html_url
      );

      console.log(
        chalk.gray("Clone:"),
        repository.clone_url
      );

      if (options.init !== false) {
        const localSpinner = ora(
          "Initializing local repository..."
        ).start();

        try {
          const readme = createReadme(
            name,
            options.description
          );

          await initializeLocalRepository(
            repositoryOptions.directory!,
            repository.clone_url,
            readme
          );

          localSpinner.succeed(
            "Local repository initialized and pushed."
          );

          console.log();
          console.log(
            chalk.green("✓ Project ready:")
          );

          console.log(
            chalk.gray(
              `  ${repositoryOptions.directory}`
            )
          );
        } catch (error) {
          localSpinner.fail(
            "Git initialization failed."
          );

          throw error;
        }
      }
    } catch (error: any) {
      spinner.fail("Repository creation failed.");

      console.error();
      console.error(
        chalk.red(
          error?.message ?? "Unknown error"
        )
      );

      process.exitCode = 1;
    }
  });

program
  .command("whoami")
  .description("Display the authenticated GitHub account")
  .action(async () => {
    try {
      const github = new GitHubClient();
      const username =
        await github.getAuthenticatedUser();

      console.log(
        `${chalk.green("GitHub user:")} ${username}`
      );
    } catch (error: any) {
      console.error(
        chalk.red(
          error?.message ?? "Authentication failed."
        )
      );

      process.exitCode = 1;
    }
  });

program.parseAsync(process.argv);


