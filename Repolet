export type RepositoryVisibility = "public" | "private";

export interface RepositoryOptions {
  name: string;
  description?: string;
  visibility: RepositoryVisibility;
  private: boolean;
  initialize: boolean;
  gitignore?: string;
  license?: string;
  directory?: string;
}

export interface GitHubRepository {
  id: number;
  name: string;
  full_name: string;
  html_url: string;
  clone_url: string;
  ssh_url: string;
  private: boolean;
}


