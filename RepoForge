import os
import subprocess
from pathlib import Path


PROJECT_NAME = "RepoForge"


def create_repository(name: str, description: str = ""):
    """Create a new GitHub-ready repository locally."""

    repo_path = Path(name)

    if repo_path.exists():
        print(f"❌ Repository '{name}' already exists.")
        return

    repo_path.mkdir()

    # Create basic project structure
    (repo_path / "src").mkdir()
    (repo_path / "tests").mkdir()
    (repo_path / "README.md").write_text(
        f"# {name}\n\n{description}\n",
        encoding="utf-8"
    )
    (repo_path / ".gitignore").write_text(
        "__pycache__/\n.env\n.venv/\n*.pyc\n",
        encoding="utf-8"
    )

    # Initialize Git
    subprocess.run(["git", "init"], cwd=repo_path, check=True)

    # Initial commit
    subprocess.run(["git", "add", "."], cwd=repo_path, check=True)
    subprocess.run(
        ["git", "commit", "-m", "Initial commit"],
        cwd=repo_path,
        check=True
    )

    print(f"✅ Repository '{name}' created successfully.")
    print(f"📁 Location: {repo_path.absolute()}")


if __name__ == "__main__":
    name = input("Enter repository name: ").strip()
    description = input("Enter repository description: ").strip()

    create_repository(name, description)
